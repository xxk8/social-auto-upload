{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": false,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@playwright/test": [
        "../../sau_web/frontend/node_modules/@playwright/test"
      ]
    },
    "typeRoots": [
      "../../sau_web/frontend/node_modules/@types"
    ]
  },
  "include": [
    "./**/*.ts"
  ]
}
