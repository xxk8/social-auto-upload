# social-auto-upload 环境变量配置
# 复制此文件为 .env 并按需修改

# ── 后端 (web_runner.py) ──────────────────────────────────────────

# CORS 允许的来源（逗号分隔）
# 不设置则 CORS 关闭，跨域请求会被浏览器拦截
# SAU_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── AI / 剧本工坊（默认：Agnes AI 远程服务）──
# SAU_LLM_BASE_URL=http://127.0.0.1:8317/v1
# SAU_LLM_API_KEY=sk-my-secret-key-12345
# SAU_LLM_MODEL=local-chat
# SAU_LLM_LOCAL_ONLY=1          # 1=只用本地，不回退 OpenRouter
#
# Agnes AI 模型（远程）：
#   agnes-image-2.1-flash  — 文生图 / 图生图
#   agnes-video-v2.0       — 文生视频 / 图生视频 / 多图 / 关键帧
# SAU_MEDIA_BASE_URL=https://apihub.agnes-ai.com
# SAU_MEDIA_API_KEY=${AGNES_API_KEY}
# SAU_IMAGE_MODEL=agnes-image-2.1-flash
# SAU_VIDEO_MODEL=agnes-video-v2.0
#
# 注册 Agnes API Key: https://platform.agnes-ai.com/
# AGNES_API_KEY=your_agnes_api_key
#
# Agnes 视频为异步任务（POST /v1/videos → video_id，轮询 GET /agnesapi）
#
# 可选：OpenRouter 回退（需 SAU_LLM_LOCAL_ONLY=0）
# OPENROUTER_API_KEY=
# OPENROUTE_API_KEY=

# 可选：OpenRouter 回退（需 SAU_LLM_LOCAL_ONLY=0）
# OPENROUTER_API_KEY=
# OPENROUTE_API_KEY=

# 上传文件临时目录（默认 .sau_uploads/）
# SAU_UPLOADS_DIR=.sau_uploads

# ── 前端 (sau_web/frontend) ──────────────────────────────────────

# 后端 API 地址（开发模式默认走 Vite 代理，无需设置）
# 生产环境如需指定后端地址，取消注释并填写
# VITE_API_BASE_URL=http://localhost:6001
