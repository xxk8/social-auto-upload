# social-auto-upload 环境变量示例
# 复制此文件为 .env 并填入实际值（.env 已被 .gitignore 忽略，不会提交到仓库）。
# 按「段」组织，未填值 = 保持空字符串，后端/脚本按「空 = 未配置」处理。

# ═══════════════════════════════════════════════════════════════════════
#  1. 数据库（PostgreSQL-only, post-SQLite-removal）
# ═══════════════════════════════════════════════════════════════════════

# PostgreSQL 连接串（必填）
# 例：postgres://user:pass@localhost:5432/sau
DATABASE_URL=postgres://user:pass@localhost:5432/sau

# 连接池微调（可选，留空则使用默认值）
# SAU_DB_POOL_MIN=2
# SAU_DB_POOL_MAX=15
# SAU_DB_POOL_TIMEOUT=30
# SAU_DB_POOL_KWARGS={"application_name":"sau"}

# ═══════════════════════════════════════════════════════════════════════
#  2. Web 服务 / 安全
# ═══════════════════════════════════════════════════════════════════════

# Flask 密钥（生产环境必填，否则 session 不安全）
# SAU_SECRET_KEY=<随机字符串，可用 openssl rand -hex 32 生成>

# CORS 允许来源（逗号分隔）。一键启动脚本会自动注入 localhost:5173,5180
# 手动启动后端时，若前端在 5180，需显式配置：
# SAU_CORS_ALLOWED_ORIGINS=http://localhost:5180

# 是否启用认证（默认 true，设为 false 则关闭邮箱验证码登录 + OAuth）
# SAU_AUTH_ENABLED=true

# 项目对外 URL（出现在验证码邮件正文中，作为「丢线索后可执行的找回入口」）。
#   未设置 = 回退 http://localhost:5180（与 sau_web/start.sh 的 Vite 默认端口一致）。
#   生产环境务必改成实际域名（如 https://your-domain.com），不要带末尾斜杠。
#   注意：这是给用户看的「找回链接」，不是 OAuth redirect_uri —— OAuth
#   callback URL 是独立的，仍由 .env 下方 GOOGLE/GITHUB_CLIENT_ID/SECRET 区域决定。
# SAU_PUBLIC_URL=https://your-domain.com

# ═══════════════════════════════════════════════════════════════════════
#  3. OAuth 社交登录（可选）
# ═══════════════════════════════════════════════════════════════════════
#
# 配置后，登录页会出现「Google 登录」「GitHub 登录」按钮。
# 四者都留空 → 隐藏社交登录入口，不影响邮箱验证码登录。
#
# Google OAuth 2.0
#   1) 前往 https://console.cloud.google.com/apis/credentials
#   2) 创建「OAuth 2.0 客户端 ID」→ 应用类型选「Web 应用」
#   3) 授权重定向 URI 填：http://localhost:6001/api/auth/google/callback
#      （生产环境换成实际域名，如 https://your-domain.com/api/auth/google/callback）
#   4) 复制「客户端 ID」和「客户端密钥」填入下方
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App
#   1) 前往 https://github.com/settings/developers → OAuth Apps → New OAuth App
#   2) Homepage URL 填：http://localhost:5180
#   3) Authorization callback URL 填：http://localhost:6001/api/auth/github/callback
#      （生产环境换成实际域名）
#   4) 生成 Client ID 和 Client Secret 填入下方
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ═══════════════════════════════════════════════════════════════════════
#  4. SMTP / 邮箱验证码（Web Shell 登录必需，除非关闭 SAU_AUTH_ENABLED）
# ═══════════════════════════════════════════════════════════════════════

# SAU_SMTP_HOST=smtp.qq.com
# SAU_SMTP_PORT=465
# SAU_SMTP_USER=your@qq.com
# SAU_SMTP_PASS=<邮箱密码或独立授权码>
# SAU_SMTP_FROM=your@qq.com

# ═══════════════════════════════════════════════════════════════════════
#  5. AI / 图片素材搜索
# ═══════════════════════════════════════════════════════════════════════

# OpenRouter API Key（AI 内容生成用）
# OPENROUTER_API_KEY=

# ── Crawler (openspec/changes/mediacrawler-integration) ────────────
# 是否启用 IP 代理池。默认 false（裸貓访问；适合低频率调试）。高强度
# 护墙平台（小红书 / B站）推荐 true + static provider。
# SAU_CRAWLER_ENABLE_IP_PROXY=false

# 代理 provider：static / kuaidaili / wandouhttp。
# static = 使用 SAU_CRAWLER_STATIC_PROXY_URL 一个固定代理，
# kuaidaili / wandouhttp = 占位实现（后续 PR）。
# SAU_CRAWLER_IP_PROXY_PROVIDER=static

# Static 模式下使用的代理 URL（如 http://user:pass@proxy:8080）。
# SAU_CRAWLER_STATIC_PROXY_URL=

# 两次平台请求之间的间隔(秒)；控制尊守平台 ToS。
# SAU_CRAWLER_REQUEST_DELAY=1.0

# 只接受 'saulite'（PG 经由 web_runner/db.py）。为未来扩展预留。
# SAU_CRAWLER_SAVE_DATA_OPTION=saulite

# 评论 AI 情感分析模型。默认 deepseek/deepseek-chat（OpenRouter 上最
# 便宜的 bilingual 模型）。
# SAU_CRAWLER_SENTIMENT_MODEL=deepseek/deepseek-chat

# 回复建议生成模型。同样走 OpenRouter （LLaMA/Qwen 重型模型可选）。
# SAU_CRAWLER_REPLY_MODEL=deepseek/deepseek-chat

# 这两个Key 优先读取 OPENROUTER_API_KEY，仅当未设时 fallback。
# SAU_CRAWLER_OPENROUTER_API_KEY=
# SAU_CRAWLER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Agnes AI API Key（剧本工坊 AI 生成四幕用，OpenAI 兼容接口）
#   获取：https://apihub.agnes-ai.com/v1
# AGNES_API_KEY=

# Pexels API Key（图片素材搜索，免费额度 200/h + 20K/月）
#   注册：https://www.pexels.com/api/
# PEXELS_API_KEY=

# Pixabay API Key（图片素材搜索，免费额度 100/60s）
#   注册：https://pixabay.com/api/docs/
# PIXABAY_API_KEY=

# 上传文件临时目录（默认 .sau_uploads/）
# SAU_UPLOADS_DIR=.sau_uploads

# ═══════════════════════════════════════════════════════════════════════
#  6. 前端
# ═══════════════════════════════════════════════════════════════════════

# 前端 API 基地址（开发模式通常走 Vite proxy，无需设置）
# VITE_API_BASE_URL=http://localhost:6001

# 前端展示用项目链接（出现在验证码登录页 /login/auth 顶部的 pill）。
# 后端邮件正文里的同一 URL 由上面的 SAU_PUBLIC_URL 控。两边默认值都为
# http://localhost:5180，改动需同步在同一 PR 辽变 —— `web_runner/routes/
# auth.py::_public_url` 的 docstring 已显式 grep 提示。
# 未设置 = 回退 http://localhost:5180（与 sau_web/start.sh 一致）。
# VITE_PUBLIC_URL=https://your-domain.com

# ═══════════════════════════════════════════════════════════════════════
#  7. 配额 / 计费（可选，运营侧微调）
# ═══════════════════════════════════════════════════════════════════════

# 免费版配额上限
# SAU_TIER_FREE_PUBLISH=5
# SAU_TIER_FREE_AI=0
#   ↓ 自 round-AI-paywall-v1 起，此值被 `web_runner/middleware/usage_metering.py`
#   中的 tier-block 旁路：free-tier 用户调任意 `/api/ai/*` 路径时，
#   `before_request` 会先于 daily-quota 检查返回一个 HTTP 402
#   （`{"error": "tier_required", "required_tier": "pro", ...}`），根本到不了
#   `TIER_LIMITS["free"]["ai_generate"]` 这一行。所以这里的 0 不是「每日 0 次
#   AI 生成」而是「已被 pro-tier 物理旁路，变量名作为约定保留以便既有
#   `.env` 不崩溃」。如要恢复 quota 逻辑需同时调整 `_AI_FEATURE_BLOCKED_FOR_FREE`
#   ——仅改动此值 †会复活 free tier。
# SAU_TIER_FREE_ACCOUNTS=3
# SAU_TIER_FREE_INBOX=20
#   ↓ round-OPT-MONETIZE-v1 — Studio render soft-paywall. Free tier
#   users can render up to 3 projects/day; the over-quota envelope
#   carries `can_upgrade: true, required_tier: "pro"` so the React
#   side renders the UpsellModal CTA in /dashboard/studio/:id
#   instead of a plain toast (parallel to the AI tier_required
#   402 for the `ai_generate` action).
# SAU_TIER_FREE_STUDIO_RENDER=3
#   ↓ Pro tier hard-capped at 50 renders/day (NOT -1) so a
#   runaway script can't burn Pexels CDN + Remotion Chromium CPU
#   unnoticed. Future round will promote to -1 once we ship a
#   per-render creditless dollar-metered model.
# SAU_TIER_PRO_STUDIO_RENDER=50

# 是否开启用量计量（默认 true）
# SAU_METERING_ENABLED=true

# ═══════════════════════════════════════════════════════════════════════
#  8. 开发 / 调试
# ═══════════════════════════════════════════════════════════════════════

# Flask 调试模式（默认 0，开发可设为 1）
# FLASK_DEBUG=0

# 模拟授权端点（设为 true 后 authorize + SSE 返回假数据，
# 跳过"已授权"检查，无需真实平台凭证即可在浏览器中手动验证
# 完整的授权对话框流程 — 仅用于本地开发调试）
# SAU_MOCK_AUTHORIZE=true
# SAU_MOCK_AUTHORIZE_LOG=false

# 模拟 SMTP（设为 true 后 /api/auth/send-code 不再真实发邮件，
# 改为把验证码 + 邮件正文写入后端日志。验证需要扫码的真实
# 邮件流时不用起 MailHog / 真实 SMTP — 配合 tail -f 看日志即可。
# 注意：验证码本身仍然写入 verification_codes 表，/api/auth/login
# 仍能匹配通过。仅用于本地 E2E / 手动调试，生产环境不要设。
# SAU_MOCK_SMTP=true

# ═══════════════════════════════════════════════════════════════════════
#  9. 运营 / On-call
# ═══════════════════════════════════════════════════════════════════════

# 公开试用 kill criteria 告警 Webhook URL（可选）
#   触发条件 / 负载格式见 docs/dev/public-inbox-ops.md
#   - Slack:   https://api.slack.com/messaging/webhooks
#   - 飞书:    群机器人 → 自定义机器人 → webhook 地址
#   - Discord: Channel Settings → Integrations → Webhooks
# SAU_HEALTH_WEBHOOK_URL=
#   账号健康度告警 Webhook URL（可选，POST JSON 格式见 docs/install.md §11）
#   注意：该 env 变量优先级低于页面配置（webhooks_config 表），仅在无 DB 配置时使用。
# SAU_KILL_CRITERIA_WEBHOOK=

# ═══════════════════════════════════════════════════════════════════════
#  9.5 上传/系统事件 Webhook 通知（可选，openspec/changes/webhook-notifications）
#   这些 .env 值是只读 baseline；页面 /api/webhooks/config 写入的 DB 配置会覆盖它们。
#   支持飞书 / 钉钉 / 企业微信 / 自定义 URL。URL 必须使用 https。
#   - 飞书:     群机器人 → 自定义机器人 → webhook 地址 + 签名密钥(secret)
#   - 钉钉:     智能群助手 → 自定义机器人(加签) → webhook 地址 + 加签密钥(secret)
#   - 企业微信:  群机器人 → webhook key（URL 即凭证，无需 secret）
#   页面配置支持按 platform / account 维度路由（最具体匹配优先）。
# SAU_WEBHOOK_URL=
# SAU_FEISHU_WEBHOOK_URL=
# SAU_FEISHU_WEBHOOK_SECRET=
# SAU_DINGTALK_WEBHOOK_URL=
# SAU_DINGTALK_WEBHOOK_SECRET=
# SAU_WEWORK_WEBHOOK_URL=
# 失败聚合窗口（秒）：同窗口内多条 upload.failed 合并为一条摘要卡片
# SAU_WEBHOOK_AGG_WINDOW=60

# Inbox cookie 诊断日志开关（设为 true 开启详细 cookie 诊断日志）
# INBOX_LOG_COOKIE_DIAG=false

# ═══════════════════════════════════════════════════════════════════════
#  10. Studio 白板（剧本工坊画布数据大小上限）
# ═══════════════════════════════════════════════════════════════════════

# 画布数据大小上限，单位是 **UTF-8 编码字节数**（不是 Python `str` 字符数）。
# 度量公式：len(json.dumps(canvas_data, ensure_ascii=False, separators=(",", ":")).encode("utf-8"))
# `ensure_ascii=False` + `separators=(",", ":")` 是必填项——这样后端产出的 JSON 字节流
# 与前端 JSON.stringify + TextEncoder().encode() 完全一致，避免 CJK 重负载下前后端边界错开 ~30%。
# 默认 10485760 字节 = 10 MiB（1024 × 1024 × 10，二进制 MiB，不是 10 MB 十进制）。如果画布主要是中文 / Emoji，请留默认值或调高。
# 详见 openspec/changes/studio-whiteboard/specs/canvas-editor/spec.md。
# SAU_STUDIO_CANVAS_MAX_SIZE=10485760
