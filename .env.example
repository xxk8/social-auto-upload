# social-auto-upload 环境变量配置
# 复制此文件为 .env 并按需修改

# ── 数据库 ───────────────────────────────────────────────────────

# 数据库方言：postgres（推荐）或 sqlite（零配置）
# 本地开发建议设为 sqlite，避免需要 Postgres 服务
# SAU_DB_DIALECT=sqlite

# PostgreSQL 连接串（SAU_DB_DIALECT=postgres 时必需）
# DATABASE_URL=postgres:///sau
# DATABASE_URL=postgres://user:pass@localhost:5432/sau

# 连接池配置（可选）
# SAU_DB_POOL_MIN=2
# SAU_DB_POOL_MAX=15
# SAU_DB_POOL_TIMEOUT=30

# ── 后端 (run.py) ────────────────────────────────────────────────

# CORS 允许的来源（逗号分隔）
# 不设置则 CORS 关闭，跨域请求会被浏览器拦截
# sau_web/start.sh 会自动注入默认值 http://localhost:5173,5180（唯一前端 Vite 默认端口）。
# Web Shell dashboard (`:5180`) 会跨域访问 `/api/*`，必须包含在列；官网首页（`/`）与 Web Shell 同处同一 Vite 域名下、不需另外加入 CORS 白名单。
# SAU_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180

# OpenRouter API Key（用于 AI 内容生成）
# 也可在 Web UI 的 AI 侧边栏中配置
# OPENROUTER_API_KEY=

# ── 图片搜索 (Pexels + Pixabay) ────────────────────────────────
# AI 助手侧栏「图片素材」折叠面板使用 (Pexels + Pixabay 双源) :
# — 手动搜图：用户输入关键词 → 后端并发调两源 → 3×3 缩略图网格
# — 自动推荐：用户编辑标题后 1.5s 空闲 → 推荐 9 张候选（session cap = 3）
# 两源 都没设 key ：`POST /api/ai/images/search` 返 503 + 中文提示, UI 会 refuse 打开
# 设一个或两个：后端并发聚合 + 跨源去重 + partial-degradation 单源 failover
# 完整 onboarding (signup 网址、key 位置、free-tier 限额、合规要求) 见：
#   docs/ai-material-search.md
# Rate limits（以服务侧 free tier 为准）：
#   Pexels — 200 req/hour + 20 000 req/month
#   Pixabay — 100 req/60 秒（不计月）
# 后端还以 30 req/min/user 滑动窗口护你不会一下子烧光 free-tier。
#
# PEXELS_API_KEY=
# PIXABAY_API_KEY=

# 上传文件临时目录（默认 .sau_uploads/）
# SAU_UPLOADS_DIR=.sau_uploads

# ── 前端 (sau_web/frontend) ──────────────────────────────────────

# 后端 API 地址（开发模式默认走 Vite 代理，无需设置）
# 生产环境如需指定后端地址，取消注释并填写
# VITE_API_BASE_URL=http://localhost:6001

# ── 认证 ──────────────────────────────────────────────────────────

# Flask session 签名密钥（不设置则自动生成并存入 db/.secret_key）
# 生产环境强烈建议设置一个随机值
# SAU_SECRET_KEY=your-random-secret-key-here

# 禁用认证（设置后无需登录，/api/auth/me 返回虚拟管理员用户）
# SAU_AUTH_ENABLED=false

# 模拟授权端点（设为 true 后 authorize + SSE 返回假数据，
# 跳过"已授权"检查，无需真实平台凭证即可在浏览器中手动验证
# 完整的授权对话框流程 — 仅用于本地开发调试）
# SAU_MOCK_AUTHORIZE=true

# SMTP 邮件配置（邮箱验证码登录必需）
# SAU_SMTP_HOST=smtp.qq.com
# SAU_SMTP_PORT=465
# SAU_SMTP_USER=your@qq.com
# SAU_SMTP_PASS=your-auth-code
# SAU_SMTP_FROM=your@qq.com

# ── 告警 / Monitoring ───────────────────────────────────────────

# 公开试用 kill criteria 告警 Webhook（可选）
# 不设置则脚本在 STOP-SHIP / WATCHFUL 时不推送，只写 .sau-logs/
# 下的 verdict JSON + 日志行；dashboard banner 仍可通过
# GET /api/public-inbox/kill-criteria (admin required) 消费。
# 支持 Slack / 飞书 / Discord incoming webhook（需为 application/json POST）。
# 完整运行手册 + 阈值表：docs/dev/public-inbox-ops.md
#   - Slack:   https://api.slack.com/messaging/webhooks
#   - 飞书:    群机器人 → 自定义机器人 → webhook 地址
#   - Discord: Channel Settings → Integrations → Webhooks
# SAU_KILL_CRITERIA_WEBHOOK=https://example.com/your-webhook-url-here
